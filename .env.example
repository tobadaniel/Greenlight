# Copy to .env or export in your shell. Never commit real keys.
# SERV Reasoning key — console.openserv.ai > Settings > API Keys
SERV_API_KEY=
# Optional: any model from the SERV catalog (default gpt-5.4-mini)
SERV_MODEL=gpt-5.4-mini
# Reppo Evaluation API key — eval.reppo.xyz > sidebar > API Key
REPPO_API_KEY=
# Port for the local server
PORT=4173
